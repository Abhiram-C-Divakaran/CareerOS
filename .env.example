# CareerOS Environment Configuration (Single-User Personal Instance)
# Copy this file to .env.local and provide strong values of your own.
# Never commit .env or .env.local to version control.

# Optional: Single-user master password (minimum 8 chars).
# If left empty, you will be prompted to set up your master password in the UI on first launch,
# which is stored as a salted scrypt hash in SQLite.
CAREEROS_MASTER_PASSWORD=

# Optional: 32-byte hex or passphrase used to derive AES-256-GCM key for encrypting OAuth tokens at rest.
# If left empty, CareerOS generates a unique 256-bit random key in data/.careeros-secrets.json (gitignored).
CAREEROS_ENCRYPTION_KEY=

# Optional: Session signing secret (HMAC-SHA256).
# If left empty, CareerOS generates a unique 256-bit random secret in data/.careeros-secrets.json (gitignored).
CAREEROS_SESSION_SECRET=

# Optional: Allowed Chrome Extension Origin (e.g. chrome-extension://<your-32-char-extension-id>)
CAREEROS_ALLOWED_EXTENSION_ORIGIN=

# Optional: Set to "true" ONLY if you want to seed sample demo applications in a test environment.
# Defaults to false so real personal databases remain completely free of sample data.
CAREEROS_ENABLE_SAMPLE_DATA=false

# Official Google OAuth 2.0 Credentials (for Gmail & Google Calendar integration)
# Create at https://console.cloud.google.com/apis/credentials
# Enable: Gmail API (readonly scope) and Google Calendar API (calendar.events.readonly scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Optional: Gemini API Key for enhanced Daily AI Briefings
GEMINI_API_KEY=

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
