# CareerOS Environment Configuration (Single-User Personal Instance)

# Single-user master password (defaults to "careeros-admin-2026" in local dev if unset)
CAREEROS_MASTER_PASSWORD=careeros-admin-2026

# 32-byte hex or passphrase used to derive AES-256-GCM key for encrypting OAuth tokens at rest
# (Never expose to client/frontend)
CAREEROS_ENCRYPTION_KEY=careeros-local-aes256-gcm-secret-key-change-in-prod

# Session signing secret (HMAC-SHA256)
CAREEROS_SESSION_SECRET=careeros-hmac-sha256-session-signing-secret-2026

# Official Google OAuth 2.0 Credentials (for Gmail & Google Calendar integration)
# Create at https://console.cloud.google.com/apis/credentials
# Enable: Gmail API (readonly scope) and Google Calendar API (events.readonly / calendar.events scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Optional: Gemini API Key for enhanced Daily AI Briefings (falls back to deterministic AI heuristics if unset)
GEMINI_API_KEY=

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
